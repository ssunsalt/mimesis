---
import Layout from "../../layouts/Layout.astro";

// 캐릭터 정보 - 여기 텍스트/색상을 직접 수정하시면 돼요
const charactersInfo = [
  {
    iconColor: "#b2b98b",
    nameKr: "메티스",
    nameEn: "Metis",
    stats: "  직업 | 성별 | 나이 | 키 | 몸무게  ",
  },
  {
    iconColor: "#8b8db9",
    nameKr: "미리엘",
    nameEn: "Myriel",
    stats: "  직업 | 성별 | 나이 | 키 | 몸무게  ",
  },
];
---
<Layout title="MIMESIS" wide={true}>
  <div class="character-hero">
    <div class="profile-toggle">
      <a href="/mimesis" class="profile-toggle-btn">ORIGIN</a>
      <a href="/mimesis/modern" class="profile-toggle-btn is-active">MODERN</a>
    </div>

    <img src="/images/character2.png" alt="캐릭터" class="character-hero-img" />

    <div class="character-info character-info-left">
      <span class="character-icon" style={`color:${charactersInfo[0].iconColor};`}>✸</span>
      <p class="character-name-kr">{charactersInfo[0].nameKr}</p>
      <p class="character-name-en">{charactersInfo[0].nameEn}</p>
      <div class="character-stats">{charactersInfo[0].stats}</div>
    </div>

    <div class="character-info character-info-right">
      <span class="character-icon" style={`color:${charactersInfo[1].iconColor};`}>✸</span>
      <p class="character-name-kr">{charactersInfo[1].nameKr}</p>
      <p class="character-name-en">{charactersInfo[1].nameEn}</p>
      <div class="character-stats">{charactersInfo[1].stats}</div>
    </div>
  </div>
</Layout>
