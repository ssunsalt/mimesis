---
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../lib/notion.js";

const posts = await getPosts("GALLERY");
---
<Layout title="GALLERY">
  {posts.length === 0 && <p class="empty-msg">등록된 글이 없습니다.</p>}
  <ul class="post-list is-gallery">
    {posts.map((post) => (
      <li class="post-item">
        <a href={`/gallery/${post.id}`} class="post-link">
          <span class="post-thumb" style={`background-image:url(${post.thumbnail});`}></span>
        </a>
      </li>
    ))}
  </ul>
</Layout>
