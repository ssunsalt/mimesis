---
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../lib/notion.js";
import { getEmbedUrl } from "../../lib/sheet.js";

export async function getStaticPaths() {
  const posts = await getPosts("SHEET");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const embedUrl = getEmbedUrl(post.sheetUrl);
---
<Layout title={post.title} wide={true} backLink="/sheet">
 <div class="sheet-embed-wrap">
  {!embedUrl && (
    <p class="empty-msg">시트 링크를 확인해주세요.</p>
  )}
  {embedUrl && (
    <div class="sheet-embed-scale">
      <iframe src={embedUrl} class="sheet-embed-frame" loading="lazy"></iframe>
    </div>
  )}
</div>
</Layout>